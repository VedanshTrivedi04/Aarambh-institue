# ============================================================
# Aarambh ERP — Environment Variables (.env.example)
# Copy this file to .env and fill in real values for each env.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=dev                         # dev | staging | prod
DEBUG=true                          # MUST be false in production
APP_NAME="Aarambh Institute ERP"
APP_VERSION="0.1.0"
SECRET_KEY=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING  # openssl rand -hex 32

# --- Database (asyncpg) ---
DATABASE_URL=postgresql+asyncpg://aarambh_user:aarambh_pass@localhost:5432/aarambh_erp_dev
TEST_DATABASE_URL=postgresql+asyncpg://aarambh_user:aarambh_pass@localhost:5432/aarambh_erp_test

# --- JWT ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aarambh-institute.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- File Storage ---
STORAGE_BACKEND=local               # local | s3
LOCAL_STORAGE_PATH=./uploads        # used when STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1

# --- Celery / Background Tasks ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Rate Limiting (requests per minute per IP) ---
RATE_LIMIT_AUTH_RPM=10              # /login, /refresh, /forgot-password

# --- Razorpay (online fee payments) ---
RAZORPAY_KEY_ID=                    # rzp_test_xxxxxxxx (Dashboard > Settings > API Keys)
RAZORPAY_KEY_SECRET=                # keep secret, backend-only
RAZORPAY_WEBHOOK_SECRET=            # Dashboard > Settings > Webhooks > your endpoint's secret
