# =============================================================================
# Aarambh Institute ERP — Frontend Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: Add these variables in Project Settings > Environment Variables
# =============================================================================

# FastAPI backend URL (without trailing slash).
# The browser never calls this directly: next.config.ts proxies /api/v1/* to it,
# which keeps the httpOnly refresh-token cookie first-party.
# Local:      http://127.0.0.1:8000
# Production: https://aarambh-erp-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# Razorpay Key ID (Public key for student fee payments)
# Example: rzp_test_xxxxxxxxxxxxxx or rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=
